---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const experiences = await getCollection('experiences');
  return experiences.map((exp) => ({
    params: { slug: exp.slug },
    props: { exp },
  }));
}

const { exp } = Astro.props;
const { data } = exp;
const { Content } = await render(exp);

const dateRange = `${data.startDate.getFullYear()}${data.endDate ? `–${data.endDate.getFullYear()}` : '–present'}`;
---

<BaseLayout title={`${data.title} | sokmontrey.me`}>
  <main class="page-main">

    <a href="/experiences" class="back-link mono-font" onclick="if(history.length>1){event.preventDefault();history.back()}">&lt; back</a>

    <header>
      <h1 class="serif-font page-h1 nt-color">{data.title}</h1>
      <p class="mono-font page-tag">[{data.company} · {dateRange}]</p>
    </header>

    {data.achievements && data.achievements.length > 0 && (
      <ul class="achievements">
        {data.achievements.map(item => (
          <li class="achievement mono-font lt2-color">
            <span class="lt-color">—&nbsp;</span>{item}
          </li>
        ))}
      </ul>
    )}

    {data.technologies && data.technologies.length > 0 && (
      <p class="mono-font tech-list">[{data.technologies.join(' · ')}]</p>
    )}

    <hr class="divider" />

    <div class="prose-content">
      <Content />
    </div>

  </main>
</BaseLayout>

<style>
  .page-main {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 2rem 8rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--lt2-color);
    opacity: 0.6;
    margin-bottom: 3rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .back-link:hover { opacity: 1; color: var(--pm-color); }

  .page-h1 {
    font-size: 2.8rem;
    line-height: 1.1;
    margin-bottom: 0.4rem;
  }

  .page-tag {
    font-size: 0.92rem;
    color: var(--lt2-color);
    margin-bottom: 1.6rem;
  }

  .achievements {
    list-style: none;
    padding: 0;
    margin-bottom: 1.4rem;
  }

  .achievement {
    display: flex;
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }

  .tech-list {
    font-size: 0.88rem;
    color: var(--lt-color);
    opacity: 0.7;
    margin-bottom: 2rem;
  }

  .divider {
    border: none;
    border-top: 1px dashed #2a3340;
    margin-bottom: 2.5rem;
  }

  /* ── Prose ──────────────────────────────────────── */
  .prose-content {
    font-family: var(--sans-font);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--lt2-color);
  }
  .prose-content :global(p)      { margin-bottom: 1.1rem; }
  .prose-content :global(strong) { color: var(--nt-color); font-weight: 600; }
  .prose-content :global(ul)     { list-style: none; padding: 0; margin-bottom: 1rem; }
  .prose-content :global(li)     { margin-bottom: 0.45rem; padding-left: 1.4rem; position: relative; }
  .prose-content :global(li)::before { content: '—'; position: absolute; left: 0; color: var(--lt-color); }
  .prose-content :global(a)      { color: var(--lt2-color); text-decoration: underline; text-underline-offset: 3px; }
  .prose-content :global(a:hover){ color: var(--pm-color); }
  .prose-content :global(h2)     { font-family: var(--serif-font); font-size: 1.6rem; color: var(--nt-color); margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .prose-content :global(h3)     { font-family: var(--serif-font); font-size: 1.25rem; color: var(--nt-color); margin-top: 1.8rem; margin-bottom: 0.5rem; }
  .prose-content :global(code)   { font-size: 0.88em; color: var(--lt2-color); background: #0f1b2b; padding: 0.15em 0.4em; border-radius: 2px; }
</style>
