---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllExperiences } from '../../lib/content';

const experiences = await getAllExperiences();
---

<BaseLayout title="Experiences | sokmontrey.me">
  <main class="page-main">

    <a href="/" class="back-link mono-font" onclick="if(history.length>1){event.preventDefault();history.back()}">&lt; back</a>

    <h1 class="serif-font h1 page-title nt-color">Experiences</h1>

    <ul class="entry-list">
      {experiences.map(exp => (
        <li class="dict-entry">
          <a href={`/experiences/${exp.slug}`} class="dict-head-link">
            <span class="dict-title serif-font">{exp.data.title}</span>
          </a>
          <p class="mono-font dict-tag">
            [{exp.data.company} · {exp.data.startDate.getFullYear()}{exp.data.endDate ? `–${exp.data.endDate.getFullYear()}` : '–present'}]
          </p>
          <p class="sans-font dict-def lt2-color">{exp.data.description.split('\n')[0]}</p>
        </li>
      ))}
    </ul>

  </main>
</BaseLayout>

<style>
  .page-main {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 2rem 8rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--lt2-color);
    opacity: 0.6;
    margin-bottom: 3rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .back-link:hover { opacity: 1; color: var(--pm-color); }

  .page-title { margin-bottom: 2.5rem; }

  .entry-list { list-style: none; padding: 0; }

  .dict-entry {
    padding: 1.2rem 0;
    border-top: 1px dashed var(--border-color);
  }
  .dict-entry:first-of-type { border-top: none; }

  .dict-head-link {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--nt-color);
  }
  .dict-head-link:hover .dict-title { color: var(--pm-color); }

  .dict-title {
    font-size: 1.5rem;
    line-height: 1.2;
    transition: color 0.15s ease;
    display: block;
  }

  .dict-tag {
    font-size: 0.88rem;
    color: var(--lt2-color);
    margin-bottom: 0.4rem;
    margin-top: 0.15rem;
  }

  .dict-def {
    font-size: 1rem;
    line-height: 1.7;
    width: 100%;
  }
</style>
