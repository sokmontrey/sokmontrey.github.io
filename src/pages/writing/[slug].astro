---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const writings = await getCollection('writing');
  return writings.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);

const dateStr = data.date
  ? new Date(data.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : '';
---

<BaseLayout title={`${data.title} | sokmontrey.me`}>
  <main class="page-main">

    <a href="/writings" class="back-link mono-font" onclick="if(history.length>1){event.preventDefault();history.back()}">&lt; back</a>

    {data.image && <img src={data.image} alt={data.title} class="page-image" />}

    <header>
      <h1 class="serif-font page-h1 nt-color">{data.title}</h1>
      {dateStr && (
        <p class="mono-font page-tag">
          <span class="lt-color">{dateStr}</span>
        </p>
      )}
    </header>

    {data.link && (
      <a href={data.link} target="_blank" class="ext-link mono-font">
        <span class="arr">&gt;</span> view original
      </a>
    )}

    {data.description && (
      <p class="mono-font page-desc lt2-color">{data.description}</p>
    )}

    <hr class="divider" />

    <div class="prose-content">
      <Content />
    </div>

  </main>
</BaseLayout>

<style>
  .page-main {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 2rem 8rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--lt2-color);
    opacity: 0.6;
    margin-bottom: 3rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .back-link:hover { opacity: 1; color: var(--pm-color); }

  .page-image {
    display: block;
    max-width: 100%;
    height: auto;
    opacity: 0.8;
    margin-bottom: 2rem;
  }

  .page-h1 {
    font-size: 2.8rem;
    line-height: 1.15;
    margin-bottom: 0.4rem;
  }

  .page-tag {
    font-size: 0.92rem;
    color: var(--lt2-color);
    margin-bottom: 1.6rem;
  }

  .ext-link {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--lt2-color);
    opacity: 0.7;
    margin-bottom: 1.5rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .ext-link:hover { opacity: 1; color: var(--pm-color); }

  .arr { margin-right: 0.1rem; transition: margin-right 0.1s ease; }
  .ext-link:hover .arr { margin-right: 0.3rem; }

  .page-desc {
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .divider {
    border: none;
    border-top: 1px dashed #2a3340;
    margin-bottom: 2.5rem;
  }

  /* ── Prose ──────────────────────────────────────── */
  .prose-content {
    font-family: var(--sans-font);
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--lt2-color);
  }
  .prose-content :global(p)          { margin-bottom: 1.3rem; }
  .prose-content :global(strong)     { color: var(--nt-color); font-weight: 600; }
  .prose-content :global(em)         { font-style: italic; }
  .prose-content :global(ul)         { list-style: none; padding: 0; margin-bottom: 1rem; }
  .prose-content :global(li)         { margin-bottom: 0.5rem; padding-left: 1.4rem; position: relative; font-size: 1rem; }
  .prose-content :global(li)::before { content: '—'; position: absolute; left: 0; color: var(--lt-color); }
  .prose-content :global(a)          { color: var(--lt2-color); text-decoration: underline; text-underline-offset: 3px; }
  .prose-content :global(a:hover)    { color: var(--pm-color); }
  .prose-content :global(h2)         { font-size: 1.6rem; color: var(--nt-color); margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .prose-content :global(h3)         { font-size: 1.25rem; color: var(--nt-color); margin-top: 1.8rem; margin-bottom: 0.5rem; }
  .prose-content :global(code)       { font-family: var(--mono-font); font-size: 0.88em; color: var(--lt2-color); background: #0f1b2b; padding: 0.15em 0.4em; border-radius: 2px; }
  .prose-content :global(blockquote) { border-left: 2px solid #2a3340; padding-left: 1rem; margin: 1.5rem 0; opacity: 0.8; }
  .prose-content :global(img)        { display: block; margin: 1.5rem auto; max-width: 100%; height: auto; }
</style>
