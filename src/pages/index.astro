---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import DotsLink from '../components/DotsLink.astro';
import { getAllProjects, getAllExperiences, getAllWriting } from '../lib/content';
import links from '../data/links.json';
import treeSvg from '../assets/tree.svg?raw';
import treeLightSvg from '../assets/tree-light.svg?raw';

const projects    = await getAllProjects();
const experiences = await getAllExperiences();
const writings    = await getAllWriting({ excludeHidden: true });

const SHOW = 3;
const SHOW_PROJECTS = 4;

const sections = [
  { name: "Projects",    id: "projects" },
  { name: "Experiences", id: "experiences" },
  { name: "Writings",    id: "writings" },
];

function toRoman(n: number): string {
  const vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
  const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let result = '';
  for (let i = 0; i < vals.length; i++) {
    while (n >= vals[i]) { result += syms[i]; n -= vals[i]; }
  }
  return result;
}

const latinPool = [
  "carpe", "diem", "nil", "sine", "magno", "vita", "labore", "dedit",
  "fructum", "per", "aspera", "ad", "astra", "dum", "spiro", "spero",
  "vivam", "ex", "animo", "surgit", "lucem", "crescit", "fac", "totum",
  "vide", "in", "lumine", "veritas", "ratio", "lucet", "numero", "more",
  "viget", "finis", "coronat", "opus", "motum", "movet", "narrat", "mores",
  "est", "transit", "ars", "longa", "brevis", "tempus", "praeceps", "fugit",
  "omnia", "mutantur", "nos", "quoque", "illis", "semper", "amor", "fides",
];

const BG_ROWS = 10;
const ROW_CHARS = 44;
let _s = 73;
function sr() { _s = (_s * 16807) % 2147483647; return (_s - 1) / 2147483646; }

function latinLine(len: number): string {
  if (len <= 0) return "";
  let line = "";
  while (line.length < len) {
    const w = latinPool[Math.floor(sr() * latinPool.length)];
    line += (line ? " " : "") + w;
  }
  return line.slice(0, len);
}

const bioLines = [
  "From software to robots,",
  "to data and AI,",
  "to community and art,",
  "I make things",
  "and tell its story.",
];

type RowData = { pre: string; bio: string | null; post: string };
const bioStart = Math.floor((BG_ROWS - bioLines.length) / 2);
const LPAD = 4;
const rows: RowData[] = [];
for (let r = 0; r < BG_ROWS; r++) {
  const bi = r - bioStart;
  if (bi >= 0 && bi < bioLines.length) {
    const bio = bioLines[bi];
    const pre = latinLine(LPAD) + " ";
    const post = " " + latinLine(ROW_CHARS - bio.length - pre.length - 1);
    rows.push({ pre, bio, post });
  } else {
    rows.push({ pre: latinLine(ROW_CHARS), bio: null, post: "" });
  }
}

const visibleLinks = links.filter(l => l.isVisible);
---

<BaseLayout title="Sokmontrey Sythat">

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <header class="hero block-container" id="intro">
    <div class="hero-wrap">
      <h1 class="serif-font nt-color hero-title">Hi. I'm Montrey.</h1>
      <div class="hero-block" id="heroBlock">
        <div class="block-text mono-font">
          {rows.map(row => (
            <p>
              <span class="lt-color">{row.pre}</span>{row.bio && <span class="bio-hl">{row.bio}</span>}<span class="lt-color">{row.post}</span>
            </p>
          ))}
        </div>
      </div>
      <a href="/about" class="more-about mono-font">more about me &gt;</a>
    </div>
    <i class="fa-solid fa-arrow-down hero-arrow lt2-color animate-bounce"></i>
  </header>

  <main>

    <!-- ── Table of Contents ─────────────────────────────────────────── -->
    <section class="block-container" style="min-height: 30vh; margin-bottom: 5vh;">
      <div class="section-inner">
        <h2 class="serif-font h1 mb-2">Contents</h2>
        <ul>
          {sections.map((s, i) => (
            <li class="mono-font">
              <DotsLink
                href={`#${s.id}`}
                width={30}
                additional_width={30}
                str={s.name}
                postfix={toRoman(i + 1)}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Sticky Nav ────────────────────────────────────────────────── -->
    <SiteNav sections={sections} />

    <!-- ── Projects ─────────────────────────────────────────────── -->
    <section class="block-container content-section" id="projects">
      <div class="section-inner">
        <div class="section-header">
          <h2 class="serif-font h1 flex-1 section-title">Projects</h2>
          <p class="serif-font h2 lt-color section-num">{toRoman(1)}</p>
        </div>
        <ul>
          {projects.slice(0, SHOW_PROJECTS).map(p => (
            <li class="dict-entry">
              {p.data.image && p.data.image !== "" && (
                <a href={`/projects/${p.slug}`} class="entry-img-wrap project-img-wrap">
                  <img src={p.data.image} alt={p.data.title} class="entry-img" />
                </a>
              )}
              <a href={`/projects/${p.slug}`} class="dict-head-link">
                <span class="dict-title serif-font">{p.data.title}</span>
              </a>
              {p.data.technologies.length > 0 && (
                <p class="mono-font dict-tag">[{p.data.technologies.slice(0, 5).join(', ')}]</p>
              )}
              <p class="sans-font dict-def lt2-color">{p.data.description}</p>
            </li>
          ))}
        </ul>
        {projects.length > SHOW_PROJECTS && (
          <a href="/projects" class="see-all mono-font">
            {projects.length - SHOW_PROJECTS}+ projects <i class="fa-solid fa-arrow-right fa-rotate-by" style="--fa-rotate-angle: -45deg;"></i>
          </a>
        )}
      </div>
    </section>

    <!-- ── Experiences ─────────────────────────────────────────── -->
    <section class="block-container content-section" id="experiences">
      <div class="section-inner">
        <div class="section-header">
          <h2 class="serif-font h1 flex-1 section-title">Experiences</h2>
          <p class="serif-font h2 lt-color section-num">{toRoman(2)}</p>
        </div>
        <ul>
          {experiences.slice(0, SHOW).map(exp => (
            <li class="dict-entry">
              <a href={`/experiences/${exp.slug}`} class="dict-head-link">
                <span class="dict-title serif-font">{exp.data.title}</span>
              </a>
              <p class="mono-font dict-tag">
                [{exp.data.company} · {exp.data.startDate.getFullYear()}{exp.data.endDate ? `–${exp.data.endDate.getFullYear()}` : '–present'}]
              </p>
              <p class="sans-font dict-def lt2-color">{exp.data.description.split('\n')[0]}</p>
            </li>
          ))}
        </ul>
        {experiences.length > SHOW && (
          <a href="/experiences" class="see-all mono-font">
            {experiences.length - SHOW}+ experiences <i class="fa-solid fa-arrow-right fa-rotate-by" style="--fa-rotate-angle: -45deg;"></i>
          </a>
        )}
      </div>
    </section>

    <!-- ── Writings ──────────────────────────────────────────────── -->
    <section class="block-container content-section" id="writings">
      <div class="section-inner">
        <div class="section-header">
          <h2 class="serif-font h1 flex-1 section-title">Writings</h2>
          <p class="serif-font h2 lt-color section-num">{toRoman(3)}</p>
        </div>
        <ul>
          {writings.slice(0, SHOW).map(w => (
            <li class="dict-entry writing-entry">
              <div class="writing-body">
                <a href={`/writings/${w.slug}`} class="dict-head-link">
                  <span class="dict-title serif-font">{w.data.title}</span>
                </a>
                {w.data.description && (
                  <p class="sans-font dict-def lt2-color">{w.data.description}</p>
                )}
              </div>
              {w.data.image && w.data.image !== "" && (
                <a href={`/writings/${w.slug}`} class="writing-thumb" aria-hidden="true" tabindex="-1">
                  <img src={w.data.image} alt="" />
                </a>
              )}
            </li>
          ))}
        </ul>
        {writings.length > SHOW && (
          <a href="/writings" class="see-all mono-font">
            {writings.length - SHOW}+ writings <i class="fa-solid fa-arrow-right fa-rotate-by" style="--fa-rotate-angle: -45deg;"></i>
          </a>
        )}
      </div>
    </section>


  </main>

  <!-- ── Tree ──────────────────────────────────────────────────────── -->
  <div class="block-container tree-wrap">
    <span class="tree-dark"><Fragment set:html={treeSvg} /></span>
    <span class="tree-light"><Fragment set:html={treeLightSvg} /></span>

    <div class="social-bar">
      {visibleLinks.map(link => (
        <a href={link.url} target="_blank" class="social-link mono-font">
          <i class={link.icon}></i>
          <span>{link.name}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- ── Footer ────────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="block-container">
      <h2 class="serif-font h1 pb-4">Have a good one!</h2>
      <a href="#intro" class="mono-font nt-color" style="font-size: 1.5rem; padding: 2rem 0;">
        <i class="fa-solid fa-arrow-up"></i>
      </a>
    </div>
    <div class="block-container" style="margin-top: 2.5rem; margin-bottom: 5vh; opacity: 0.4;">
      <p class="mono-font" style="font-size: 0.85rem;">&copy; 2026 Sokmontrey Sythat.</p>
    </div>
  </footer>

</BaseLayout>

<script>
// ── Generative wave on bio right edge ──────────────────────────────────
// Layered sine waves for constant, fluid, wind-like motion.
// Clip in % of each line so it stays aligned as the block scales.
function wave(t: number, y: number): number {
  return (
    Math.sin(y * 0.15 - t * 1.0)           * 0.35 +
    Math.sin(y * 0.08 + t * 1.4 + 2.1)     * 0.30 +
    Math.sin(y * 0.04 - t * 1.9 + 4.7)     * 0.20 +
    Math.sin(y * 0.20 + t * 0.8 + 1.3)     * 0.15
  );
}

const lines = Array.from(
  document.getElementById('heroBlock')!.querySelectorAll<HTMLElement>('p')
);
let t = 0;

function frame() {
  t += 0.025;
  lines.forEach((el, i) => {
    const n = wave(t, i * 4);
    // Keep the cut past the bio text (~70% of a 44-char line)
    const pct = 86 + n * 8; // ~78–94%
    el.style.clipPath = `polygon(0 0, ${pct}% 0, ${pct}% 100%, 0 100%)`;
  });
  requestAnimationFrame(frame);
}

requestAnimationFrame(frame);
</script>

<style>
  /* ── Layout ───────────────────────────────────────── */
  .block-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .section-inner { width: min(90vw, 680px); }
  .content-section { padding: 5rem 0; }

  .section-header {
    display: flex;
    align-items: flex-end;
    margin-bottom: 2.2rem;
  }

  .section-num { transform: translateY(-0.75rem); }
  .section-title { color: var(--lt2-color); opacity: 0.55; }

  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    min-height: 100svh;
    padding: clamp(3.5rem, 8vh, 5rem) 1.25rem clamp(1.5rem, 4vh, 2.5rem);
    box-sizing: border-box;
    justify-content: center;
    gap: clamp(1.25rem, 4vh, 2.5rem);
  }

  .hero-title {
    font-size: clamp(2rem, 8vw, 3.375rem);
    line-height: 1.05;
  }

  .hero-wrap {
    width: fit-content;
    max-width: 100%;
  }

  .hero-block {
    position: relative;
    margin-top: 0.85rem;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .block-text {
    /* Fit ~44 monospace chars to the available width (DM Mono ch ≈ 0.6em). */
    font-size: min(0.88rem, calc((100vw - 2.5rem) / 28));
    line-height: 1.85;
    white-space: nowrap;
    user-select: none;
  }

  .block-text p { margin: 0; }

  .block-text .lt-color { opacity: 0.5; }

  .block-text .bio-hl {
    color: var(--nt-color);
  }

  .more-about {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: clamp(0.85rem, 2.8vw, 0.92rem);
    color: var(--nt-color);
    transition: opacity 0.15s ease, color 0.15s ease;
    letter-spacing: 0.02em;
  }
  .more-about:hover { opacity: 0.75; color: var(--pm-color); }

  .hero-arrow {
    font-size: 1rem;
    opacity: 0.55;
  }

  @media (max-height: 640px) {
    .hero {
      padding-block: 3rem 1.5rem;
      gap: 1rem;
    }
    .more-about { margin-top: 0.9rem; }
    .hero-title { font-size: clamp(1.75rem, 7vw, 2.5rem); }
  }

  /* ── Dictionary entry ─────────────────────────────── */
  .dict-entry {
    padding: 1.2rem 0;
    border-top: 1px dashed var(--border-color);
  }
  .dict-entry:first-of-type { border-top: none; }

  .dict-head-link {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--nt-color);
  }
  .dict-head-link:hover .dict-title { color: var(--pm-color); padding-left: 1.1rem; }
  .dict-head-link:hover .dict-title::before { opacity: 1; }

  .dict-title {
    font-size: 1.5rem;
    line-height: 1.2;
    transition: color 0.15s ease, padding-left 0.2s ease;
    display: block;
    position: relative;
    padding-left: 0;
  }
  .dict-title::before {
    content: '>';
    position: absolute;
    left: 0;
    font-family: var(--mono-font);
    font-size: 0.95rem;
    color: var(--pm-color);
    opacity: 0;
    transition: opacity 0.2s ease;
    top: 50%;
    transform: translateY(-50%);
    font-variant-ligatures: none;
  }

  /* Tags on their own line */
  .dict-tag {
    font-size: 0.88rem;
    color: var(--lt2-color);
    margin-bottom: 0.4rem;
    margin-top: 0.15rem;
  }

  .dict-def {
    font-size: 1rem;
    line-height: 1.7;
    width: 100%;
  }

  /* ── Images (projects: above title) ───────────────── */
  .entry-img-wrap {
    display: block;
    margin-bottom: 0.8rem;
  }

  .entry-img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 260px;
    object-fit: contain;
    object-position: left center;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .entry-img-wrap:hover .entry-img { opacity: 1; }

  /* ── Writings: thumb left, text right ─────────────── */
  .writing-entry {
    display: flex;
    align-items: stretch;
    gap: 0.9rem;
  }

  .writing-entry :global(.writing-thumb) {
    flex: 0 0 8.5rem;
    width: 8.5rem;
    position: relative;
    overflow: hidden;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .writing-entry:hover :global(.writing-thumb) { opacity: 1; }

  .writing-entry :global(.writing-thumb) img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
  }

  .writing-body {
    flex: 1;
    min-width: 0;
    padding-block: 1.25rem;
  }

  /* ── See all ──────────────────────────────────────── */
  .see-all {
    display: inline-block;
    margin-top: 1.4rem;
    font-size: 0.92rem;
    color: var(--lt2-color);
    opacity: 0.6;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .see-all:hover { opacity: 1; color: var(--pm-color); }

  /* ── Tree + social ────────────────────────────────── */
  .tree-light { display: none; }
  :global([data-theme="light"]) .tree-dark { display: none; }
  :global([data-theme="light"]) .tree-light { display: inline; }

  .tree-wrap {
    padding: 10vh 0 3vh;
    gap: 2.5rem;
  }

  .social-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    justify-content: center;
  }

  .social-link {
    font-size: 1rem;
    color: var(--lt2-color);
    opacity: 0.7;
    transition: opacity 0.15s ease, color 0.15s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .social-link i { font-size: 1.1rem; }
  .social-link:hover { opacity: 1; color: var(--pm-color); }

  /* ── Footer ───────────────────────────────────────── */
  .footer { margin-top: 5vh; }
</style>
