---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllWriting } from '../../lib/content';

const writings = await getAllWriting({ excludeHidden: true });
---

<BaseLayout title="Writings | sokmontrey.me">
  <main class="page-main">

    <a href="/" class="back-link mono-font" onclick="if(history.length>1){event.preventDefault();history.back()}">&lt; back</a>

    <h1 class="serif-font h1 page-title nt-color">Writings</h1>

    {writings.length === 0 && (
      <p class="mono-font lt-color empty-msg">Nothing here yet.</p>
    )}

    <ul class="entry-list">
      {writings.map(w => (
        <li class="dict-entry">
          {w.data.image && w.data.image !== "" && (
            <a href={`/writings/${w.slug}`} class="writing-img-wrap">
              <img src={w.data.image} alt={w.data.title} class="entry-img" />
            </a>
          )}
          <a href={`/writings/${w.slug}`} class="dict-head-link">
            <span class="dict-title serif-font">{w.data.title}</span>
          </a>
          {w.data.tags && w.data.tags.length > 0 && (
            <p class="mono-font dict-tag">[{w.data.tags.join(', ')}]</p>
          )}
          <p class="sans-font dict-def lt2-color">{w.data.description}</p>
        </li>
      ))}
    </ul>

  </main>
</BaseLayout>

<style>
  .page-main {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 2rem 8rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--lt2-color);
    opacity: 0.6;
    margin-bottom: 3rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .back-link:hover { opacity: 1; color: var(--pm-color); }

  .page-title { margin-bottom: 2.5rem; }

  .empty-msg { margin-top: 3rem; opacity: 0.5; font-size: 1rem; }

  .entry-list { list-style: none; padding: 0; }

  .dict-entry {
    padding: 1.2rem 0;
    border-top: 1px dashed var(--border-color);
  }
  .dict-entry:first-of-type { border-top: none; }

  .dict-head-link {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--nt-color);
  }
  .dict-head-link:hover .dict-title { color: var(--pm-color); }

  .dict-title {
    font-size: 1.5rem;
    line-height: 1.2;
    transition: color 0.15s ease;
    display: block;
  }

  .dict-tag {
    font-size: 0.88rem;
    color: var(--lt2-color);
    margin-bottom: 0.4rem;
    margin-top: 0.15rem;
  }

  .dict-def {
    font-size: 1rem;
    line-height: 1.7;
    width: 100%;
  }

  .writing-img-wrap {
    display: block;
    margin-top: 1rem;
  }

  .entry-img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 260px;
    object-fit: contain;
    object-position: left center;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .writing-img-wrap:hover .entry-img { opacity: 1; }
</style>
