---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<BaseLayout title={`${data.title} | sokmontrey.me`}>
  <main class="page-main">

    <a href="/projects" class="back-link mono-font" onclick="if(history.length>1){event.preventDefault();history.back()}">&lt; back</a>

    <header>
      <h1 class="serif-font page-h1 nt-color">{data.title}</h1>
      <p class="mono-font page-tag">[{data.technologies.join(', ')}]</p>
      <p class="mono-font page-meta lt-color">{data.date.getFullYear()}</p>
    </header>

    {(data.githubUrl || data.liveUrl) && (
      <div class="page-links">
        {data.githubUrl && (
          <a href={data.githubUrl} target="_blank" class="page-link mono-font">
            <span class="arr">&gt;</span> github
          </a>
        )}
        {data.liveUrl && (
          <a href={data.liveUrl} target="_blank" class="page-link mono-font">
            <span class="arr">&gt;</span> live
          </a>
        )}
      </div>
    )}

    <p class="mono-font page-desc lt2-color">{data.description}</p>

    <hr class="divider" />

    <div class="prose-content">
      <Content />
    </div>

  </main>
</BaseLayout>

<style>
  .page-main {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 2rem 8rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--lt2-color);
    opacity: 0.6;
    margin-bottom: 3rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .back-link:hover { opacity: 1; color: var(--pm-color); }

  .page-h1 {
    font-size: 2.8rem;
    line-height: 1.1;
    margin-bottom: 0.4rem;
  }

  .page-tag {
    font-size: 0.92rem;
    color: var(--lt2-color);
    margin-bottom: 0.2rem;
  }

  .page-meta {
    font-size: 0.88rem;
    opacity: 0.55;
    margin-bottom: 1.4rem;
  }

  .page-links {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.8rem;
  }

  .page-link {
    font-size: 0.95rem;
    color: var(--lt2-color);
    opacity: 0.75;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .page-link:hover { opacity: 1; color: var(--pm-color); }

  .arr {
    margin-right: 0.1rem;
    transition: margin-right 0.1s ease;
  }
  .page-link:hover .arr { margin-right: 0.3rem; }

  .page-desc {
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .divider {
    border: none;
    border-top: 1px dashed var(--border-color);
    margin-bottom: 2.5rem;
  }

  /* ── Prose ──────────────────────────────────────── */
  .prose-content {
    font-family: var(--sans-font);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--lt2-color);
  }
  .prose-content :global(p)      { margin-bottom: 1.1rem; }
  .prose-content :global(strong) { color: var(--nt-color); font-weight: 600; }
  .prose-content :global(ul)     { list-style: none; padding: 0; margin-bottom: 1rem; }
  .prose-content :global(li)     { margin-bottom: 0.45rem; padding-left: 1.4rem; position: relative; }
  .prose-content :global(li)::before { content: '—'; position: absolute; left: 0; color: var(--lt-color); }
  .prose-content :global(a)      { color: var(--lt2-color); text-decoration: underline; text-underline-offset: 3px; }
  .prose-content :global(a:hover){ color: var(--pm-color); }
  .prose-content :global(h2)     { font-family: var(--serif-font); font-size: 1.6rem; color: var(--nt-color); margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .prose-content :global(h3)     { font-family: var(--serif-font); font-size: 1.25rem; color: var(--nt-color); margin-top: 1.8rem; margin-bottom: 0.5rem; }
  .prose-content :global(code)   { font-size: 0.88em; color: var(--lt2-color); background: var(--code-bg); padding: 0.15em 0.4em; border-radius: 2px; }
  .prose-content :global(hr)     { border: none; border-top: 1px dashed var(--border-color); margin: 2.5rem 0; }
</style>
