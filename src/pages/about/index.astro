---
import BaseLayout from "../../layouts/BaseLayout.astro";
import links from "../../data/links.json";

const visibleLinks = links.filter((l) => l.isVisible);
---

<BaseLayout title="About | sokmontrey.me">
  <main class="page-main">

    <a href="/" class="back-link mono-font lt2-color" onclick="if(history.length>1){event.preventDefault();history.back()}">&lt; back</a>

    <header class="page-header">
      <h1 class="serif-font page-h1 nt-color">Hi, I'm Sokmontrey</h1>
    </header>

    <div class="page-body">
      <p class="mono-font body-p lt2-color">
        From <span class="nt-color">software</span> to <span class="nt-color">robots</span>,
        to <span class="nt-color">data and AI</span>, to <span class="nt-color">community and art</span>,
        I <span class="nt-color">make things</span> and <span class="nt-color">tell the story</span> along the way.
      </p>

      <p class="mono-font body-p lt2-color">
        I ran the GBP Computer Science Club (2025-2026) with the goal of building
        an environment where <span class="nt-color">idea and initiative</span> form without border.
      </p>

      <p class="mono-font body-p lt2-color">
        One of its most ambitious projects is <span class="nt-color">HuskyHack</span>,
        a hackathon bringing together 150+ talented individuals to work on projects in under 24h,
        forming teams that continue to make <span class="nt-color">impacts</span> beyond the competition.
      </p>
    </div>

    <div class="social-bar">
      {visibleLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="social-link mono-font">
          <i class={link.icon}></i>
          <span>{link.name}</span>
        </a>
      ))}
    </div>

  </main>
</BaseLayout>

<style>
  .page-main {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 2rem 8rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    opacity: 0.5;
    margin-bottom: 3rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .back-link:hover { opacity: 1; color: var(--pm-color); }

  .page-header { margin-bottom: 2.5rem; }

  .page-h1 {
    font-size: 2.8rem;
    line-height: 1.1;
  }

  .page-body { display: flex; flex-direction: column; gap: 1.4rem; }

  .body-p {
    font-size: 1rem;
    line-height: 1.8;
  }

  .social-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 3rem;
  }

  .social-link {
    font-size: 0.95rem;
    color: var(--lt2-color);
    opacity: 0.7;
    transition: opacity 0.15s ease, color 0.15s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .social-link i { font-size: 1.05rem; }
  .social-link:hover { opacity: 1; color: var(--pm-color); }
</style>
