---
interface Props {
  sections: { name: string; id: string }[];
}

const { sections } = Astro.props;
const navHeight = sections.length * 24 + 64;
---

<!-- Mobile hamburger (fixed, hidden on desktop) -->
<button
  id="nav-btn"
  class="w-full backdrop-blur-sm fixed top-0 left-0 p-6 md:hidden z-[2] text-left flex items-start"
  style="background-color: var(--half-bg-color);"
>
  <i id="nav-btn-icon" class="fa-solid fa-bars text-xl nt-color"></i>
</button>

<!-- Nav links: sticky on desktop, hidden initially on mobile -->
<ul
  id="nav-container"
  class="p-8 pt-10 pb-20 md:pb-4 hidden md:block fixed md:sticky top-12 md:top-0 z-[1] mono-font text-2xl md:text-sm w-full md:w-auto"
>
  {sections.map((s) => (
    <li class="px-4">
      <a href={`#${s.id}`} class="nav-link" data-section-id={s.id}>
        {s.name}
      </a>
    </li>
  ))}
</ul>

<!--
  Spacer: same height as nav, pulled UP by navHeight via negative margin-top.
  This makes it overlap the nav's natural position at scrollY=0.
  z-[3] means it sits on top of the nav (z-[1]), hiding the links.
  As the user scrolls, the nav sticks to top:0 while the spacer scrolls away — revealing the nav.
-->
<div
  id="nav-spacer"
  class="w-full hidden md:block z-[3] relative"
  style={`height: ${navHeight}px; margin-top: -${navHeight}px; background-color: var(--bg-color);`}
></div>

<br /><br />

<style>
  ul { background: transparent; }

  .nav-link {
    color: var(--lt2-color);
    opacity: 0.7;
    text-decoration: none;
  }

  .nav-link:hover { opacity: 1; color: var(--pm-color); }

  .nav-link.active {
    color: var(--nt-color);
    opacity: 1;
  }

  /* Only the active link gets the > prefix */
  .nav-link.active::before {
    content: "> ";
  }
</style>

<script>
  function highlightCurrentSection() {
    const sections = document.querySelectorAll<HTMLElement>("[id]");
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    let currentId = "";

    sections.forEach((el) => {
      if (window.scrollY >= el.offsetTop - 120 && window.scrollY < el.offsetTop + el.offsetHeight - 120) {
        currentId = el.id;
      }
    });

    navLinks.forEach((link) => {
      if (link.dataset.sectionId === currentId) {
        link.classList.add("active");
        link.style.color = "var(--nt-color)";
        link.style.opacity = "1";
      } else {
        link.classList.remove("active");
        link.style.color = "var(--lt2-color)";
        link.style.opacity = "0.8";
      }
    });
  }

  // Mobile hamburger
  let isNavOpen = false;
  const navBtn     = document.getElementById("nav-btn");
  const navBtnIcon = document.getElementById("nav-btn-icon");
  const navContainer = document.getElementById("nav-container");

  navBtn?.addEventListener("click", () => {
    isNavOpen = !isNavOpen;
    if (isNavOpen) {
      navBtn!.classList.add("h-full");
      navBtnIcon?.classList.replace("fa-bars", "fa-xmark");
    } else {
      navBtn!.classList.remove("h-full");
      navBtnIcon?.classList.replace("fa-xmark", "fa-bars");
    }
    navContainer?.classList.toggle("hidden");
  });

  // Hide/show mobile nav button on scroll + section highlighting
  let prevScrollPos = window.pageYOffset;
  window.addEventListener("scroll", () => {
    const cur = window.pageYOffset;
    if (navBtn) {
      navBtn.style.top = (prevScrollPos > cur || isNavOpen) ? "0" : "-100%";
    }
    prevScrollPos = cur;
    highlightCurrentSection();
  });

  document.addEventListener("DOMContentLoaded", highlightCurrentSection);
</script>
